# ==========
# Application
# ==========
Logging__LogLevel__Default=Information

# ==========
# Frontend
# ==========
API_URL=http://localhost:80
API_SSR_URL=http://backend:8080

# ==========
# Backend
# ==========
# leave empty to disable Telegram auth)
Telegram__BotToken=
Telegram__ChatId=
Telegram__BotUsername=
Telegram__SkipChatMembershipCheck=true
# must be HTTPS in production
Telegram__WebAppUrl=http://localhost:80
# если будет короткая или простая строка оно в рантайме ошибку выдаст
Security__Secret=change-me-in-production
# задать и забыть
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ==========
# Nginx
# ==========
SERVER_HOST=localhost
# опционально
NGINX_PORT=80

# ==========
# Yandex Calendar
# ==========
# Web — веб-API calendar.yandex.ru по cookies (Playwright сам их продлевает); CalDav — сервисный аккаунт (ниже)
YandexCalendar__Provider=Web
# false — бронирования бота только в боте; при включении backfill догонит их в календарь (прошлые — без приглашений)
YandexCalendar__SyncEnabled=true
# ID календаря (layerId) для репетиций; пусто — интеграция выключена
YandexCalendar__LayerId=
YandexCalendar__LayerName=MusicClub — Репетиции
# начальные cookies из DevTools (нужны один раз, дальше живут в volume yandex_data)
YandexCalendar__Cookie=
# автологин Playwright, если сессия всё же протухла (не сработает при капче/2FA)
YandexCalendar__Login=
YandexCalendar__Password=
# как часто продлевать cookies (hh:mm:ss)
YandexCalendar__RefreshInterval=06:00:00

# ==========
# Yandex CalDAV (YandexCalendar__Provider=CalDav)
# ==========
YandexCalDav__BaseUrl=https://caldav.yandex.ru
YandexCalDav__User=
YandexCalDav__OrganizerCN=MusicClub
YandexCalDav__Password=

# ==========
# PostgreSQL
# ==========
POSTGRES_DB=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
# опционально
DB_PORT=5432

