# ==========
# Application
# ==========
Logging__LogLevel__Default=Information

# ==========
# Frontend
# ==========
API_URL=http://localhost:80
API_SSR_URL=http://backend:8080

# ==========
# Backend
# ==========
# leave empty to disable Telegram auth)
Telegram__BotToken=
Telegram__ChatId=
Telegram__BotUsername=
Telegram__SkipChatMembershipCheck=true
# must be HTTPS in production
Telegram__WebAppUrl=http://localhost:80
# если будет короткая или простая строка оно в рантайме ошибку выдаст
Security__Secret=change-me-in-production
# задать и забыть
ASPNETCORE_ENVIRONMENT=Production
ASPNETCORE_URLS=http://+:8080

# ==========
# Nginx
# ==========
SERVER_HOST=localhost
# опционально
NGINX_PORT=80

# ==========
# PostgreSQL
# ==========
POSTGRES_DB=db
POSTGRES_USER=admin
POSTGRES_PASSWORD=password
# опционально
DB_PORT=5432

